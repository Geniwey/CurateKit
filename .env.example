# =============================================================================
# CurateKit — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development and fill in the values.
# Everything is optional EXCEPT Supabase + Neon, which the app needs to run
# end-to-end (auth + database). PostHog and Sentry are safe to leave blank —
# the app simply runs without them.
#
# For Vercel: add these same keys under Project -> Settings -> Environment
# Variables (use "Production" scope). See the README for step-by-step guides.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Auth
# -----------------------------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API.
#   URL     = "Project URL"
#   anon    = "Project API keys" -> anon / public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Neon (Serverless Postgres) via Prisma
# -----------------------------------------------------------------------------
# From the Neon dashboard -> your project -> Connection Details.
#   DATABASE_URL  = the "Pooled connection" string (ends in ?pgbouncer=true),
#                   used by the running app.
#   DIRECT_URL    = the "Direct connection" string, used by Prisma CLI for
#                   migrations / Studio.
# Neon provides both for the same branch. Example (replace placeholders):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true
#   DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# PostHog (optional — leave blank to disable analytics)
# -----------------------------------------------------------------------------
# From the PostHog dashboard: Project Settings -> Project API Key.
#   NEXT_PUBLIC_POSTHOG_KEY  = "Project API key" (phc_...)
#   NEXT_PUBLIC_POSTHOG_HOST = your region's ingestion host (default is fine)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Sentry (optional — leave blank to disable error monitoring)
# -----------------------------------------------------------------------------
# From Sentry: create a project, then copy the "DSN" from Project Settings
# -> Client Keys (DSN). Use it for BOTH keys below (server + client).
#   SENTRY_DSN               = used by the server runtime (instrumentation)
#   NEXT_PUBLIC_SENTRY_DSN   = used by the browser
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sampling rate for traces (0.0–1.0). Keep low on the free tier.
SENTRY_TRACES_SAMPLE_RATE=0.1
